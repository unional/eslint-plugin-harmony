{
	"name": "eslint-plugin-harmony",
	"version": "7.2.1",
	"description": "eslint config that works in harmony with different IDEs",
	"keywords": [
		"eslint",
		"eslint-plugin",
		"eslintplugin",
		"javascript",
		"prettier",
		"styleguide",
		"tslint",
		"typescript"
	],
	"homepage": "https://github.com/cyberuni/eslint-plugin-harmony",
	"bugs": {
		"url": "https://github.com/cyberuni/eslint-plugin-harmony/issues"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/cyberuni/eslint-plugin-harmony"
	},
	"license": "MIT",
	"author": "Unional",
	"main": "lib/index.js",
	"files": [
		"lib",
		"ide-configs"
	],
	"scripts": {
		"build": "tsc -p tsconfig.lib.json",
		"build:watch": "tsc -w",
		"lint": "eslint .",
		"nuke": "rimraf lib node_modules",
		"prepare": "husky",
		"prettier": "prettier spec/ts-prettier/**/*.pass.ts --write",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc -p tsconfig.check.json",
		"verify": "pnpm build && pnpm typecheck && pnpm lint && pnpm test",
		"version": "changeset version",
		"release": "changeset publish",
		"cs": "changeset"
	},
	"dependencies": {
		"@eslint/js": "^10.0.1",
		"@typescript-eslint/utils": "^8.68.0"
	},
	"devDependencies": {
		"@changesets/cli": "^3.0.0",
		"@commitlint/cli": "21.2.2",
		"@commitlint/config-conventional": "21.2.2",
		"@types/node": "24.13.3",
		"@typescript-eslint/eslint-plugin": "^8.68.0",
		"@typescript-eslint/parser": "^8.68.0",
		"eslint": "9.39.5",
		"eslint-config-prettier": "^10.0.0",
		"eslint-plugin-harmony": "link:.",
		"globals": "^17.11.0",
		"husky": "9.1.7",
		"prettier": "3.9.6",
		"rimraf": "6.1.3",
		"typescript": "5.9.3",
		"typescript-eslint": "^8.68.0",
		"vitest": "4.1.11"
	},
	"peerDependencies": {
		"@typescript-eslint/eslint-plugin": ">= 8.0.0",
		"@typescript-eslint/parser": ">= 8.0.0",
		"eslint": ">= 8.57.0",
		"eslint-config-prettier": ">= 9.0.0",
		"typescript-eslint": ">= 8.0.0"
	},
	"peerDependenciesMeta": {
		"@typescript-eslint/eslint-plugin": {
			"optional": true
		},
		"@typescript-eslint/parser": {
			"optional": true
		},
		"eslint-config-prettier": {
			"optional": true
		},
		"typescript-eslint": {
			"optional": true
		}
	},
	"packageManager": "pnpm@11.25.0"
}
